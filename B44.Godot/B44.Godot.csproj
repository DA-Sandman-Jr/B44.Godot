<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 matches the lowest-targeting private consumer. Raising this
         would strand a consumer, so it moves only when all of them have. -->
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>B44.Godot</PackageId>
    <Version>0.3.2</Version>
    <Authors>DA-Sandman-Jr</Authors>
    <Company>B44 Labs</Company>
    <Description>Godot-side adapters and headless composition smoke testing for B44 games. The engine-coupled counterpart to the engine-free B44.Common.</Description>
    <RepositoryUrl>https://github.com/DA-Sandman-Jr/B44.Godot</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- All rights reserved is not an SPDX identifier, so the licence travels
         as a bundled file rather than an expression. Also stops nuget.org
         warning "License missing" on every publish. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 David Sanders (B44 Labs). All rights reserved.</Copyright>
    <RootNamespace>B44.Godot</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- ScriptPathAttribute maps a script type to its res:// file. Nothing in
         this package lives under res:// — a game's subclass carries the script
         path — and the generator hard-fails without GodotProjectDir, which only
         Godot.NET.Sdk sets. The remaining generators are the ones that matter:
         they produce the engine dispatch for _Ready and _Process. -->
    <GodotDisabledSourceGenerators>ScriptPathAttribute</GodotDisabledSourceGenerators>

    <!-- Released-compatibility validation, stock .NET Package Validation. It
         runs inside `dotnet pack` and diffs this package against the one named
         below, which is downloaded during restore, so the release workflow's
         no-build pack keeps working unchanged.

         A test suite protects the API surface it exercises: delete a member a
         test calls, or change its signature, and the test stops compiling. It
         says nothing about the rest — nothing here calls a member purely to
         prove it still exists, so public API no test happens to touch can be
         removed or narrowed with the suite still green. Package Validation
         compares the whole published surface rather than the exercised slice.
         A game would otherwise find out when it floats onto the new version
         and fails to compile. This moves that to pack time.

         Separate concern from the composition smoke. That proves a packaged
         Node still boots and dispatches inside a real engine; this proves the
         surface a game compiles against did not change underneath it. Neither
         substitutes for the other.

         0.3.2 is the latest version actually published to nuget.org, confirmed
         listed rather than inferred from the tag. The baseline should represent
         the latest published compatibility surface while the next release is
         being developed, and must be advanced after each successful publish: a
         stale baseline is not merely stricter, because API added after it and
         removed again never enters the comparison at all.

         Breaks are expected at a 0.x minor and are not forbidden here; they
         become explicit. Record a deliberate one in CompatibilitySuppressions.xml
         via `dotnet pack -p:GenerateCompatibilitySuppressionFile=true`, so the
         file is the reviewable list of what was broken on purpose. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.3.2</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Godot.NET.Sdk normally declares this for the generators. Referencing the
         generators outside that SDK means declaring it here, or the property is
         invisible to them and the disable above silently does nothing. -->
    <CompilerVisibleProperty Include="GodotDisabledSourceGenerators" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only. The consuming game's Godot.NET.Sdk supplies GodotSharp
         at runtime, and forcing our version into its output would fight the SDK.
         PrivateAssets keeps the reference from flowing to consumers. -->
    <PackageReference Include="GodotSharp" Version="4.7.0" PrivateAssets="all" />

    <!-- The engine-free half. This package is its Godot-side counterpart, so the
         dependency runs one way only: B44.Common never references this. Bounded
         float, like every internal B44 reference. -->
    <PackageReference Include="B44.Common" Version="0.11.*" />

    <!-- Godot's source generators ship inside Godot.NET.Sdk, which this package
         deliberately does not use — so without this reference they never run
         here, and a Node type declared in this assembly gets no engine dispatch
         at all: no InvokeGodotClassMethod override, so an overridden _Ready or
         _Process is simply never called. A consuming game's generator does not
         cover it either; it only sees the game's own declarations.
         Verified 2026-08-01 by reading generated sources on both sides.
         OutputItemType=Analyzer is how a generator is referenced outside the SDK. -->
    <PackageReference Include="Godot.SourceGenerators" Version="4.7.0"
                      PrivateAssets="all" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
